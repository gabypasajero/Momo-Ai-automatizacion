# Copia este archivo como .env.local y completa los valores. Nunca subas .env.local al repositorio.

# --- Supabase (backend) ---
# Obligatorias. La clave publicable puede estar en el navegador: la seguridad la dan las políticas RLS.
NEXT_PUBLIC_SUPABASE_URL=https://bmxmqhbkgvgyqpwsuazm.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_C4bwkSAfBBHNg8z523_qpw_P-PDzciI
# Las cuentas y equipos los gestiona la Edge Function momo-usuarios (usa la clave service_role que
# Supabase le entrega): la app no necesita la clave secreta.

# --- Meta: Messenger / Facebook (piloto) ---
META_APP_ID=
META_APP_SECRET=
# Texto que inventas tú; se pega igual en el panel de webhooks de Meta.
META_WEBHOOK_VERIFY_TOKEN=
# Token de acceso de la Página de Facebook (larga duración).
META_PAGE_ACCESS_TOKEN=

# --- IA ---
# Solo servidor. Activa las sugerencias de Momo y el asistente del equipo (docs/puesta-en-marcha.md §5).
ANTHROPIC_API_KEY=
